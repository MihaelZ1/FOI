#include <iostream>
#include <cmath>
#include <iomanip>
using namespace std;
int main() {
	int a,b;
	cout<<"Unesite prvi broj: ";
	cin>>a;
	cout<<"Unesite drugi broj: ";
	cin>>b;
	
	
	
	cout<<a<<" + "<<b<<" = "<<a+b<<endl;
	cout<<a<<" - "<<b<<" = "<<a-b<<endl;
	cout<<a<<" x "<<b<<" = "<<a*b<<endl;
	cout<<a<<" / "<<b<<" = "<<(float)a/b<<endl;
	float x1 = sqrt(a);
	float x2 = sqrt(b);
    cout<< "Korijen prvoga: " << setprecision(8) << x1 <<endl;
    cout<< "Korijen drugoga: " << setprecision(8) << x2 <<endl;
	
return 0;
	
	

}

